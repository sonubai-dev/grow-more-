# ==========================================
# GrowMore Production Environment Variables
# Copy this file to .env.local or set these in Netlify / Cloud Run
# ==========================================

# ------------------------------------------
# Firebase Web Client Configuration (Required)
# Found in: Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseWebApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="your-app-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-app-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# Comma-separated list of admin email addresses
VITE_ADMIN_EMAILS="admin@zellonai.online,ssdd747346@gmail.com"

# ------------------------------------------
# Google Maps Platform Configuration (Optional / Enhancements)
# Places API & Maps JavaScript API for address auto-completion and place matching
# ------------------------------------------
VITE_GOOGLE_MAPS_API_KEY=""

# ------------------------------------------
# Optional Backend / Server-Side Variables
# ------------------------------------------
GEMINI_API_KEY=""
APP_URL="https://your-domain.netlify.app"
